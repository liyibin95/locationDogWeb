# MongoDB Connection String (Vercel MongoDB / Atlas)
# In Vercel, this is auto-populated when integrating MongoDB Atlas.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/next_log?retryWrites=true&w=majority
MONGODB_DB=next_log

# API Key for POST /api/logs authentication
# Passed via `x-api-key: your-secret-api-key` or `Authorization: Bearer your-secret-api-key`
LOG_API_KEY=next-log-secret-key-2026

# 页面访问密码 (用于保护日志管理后台页面)
PAGE_PASSWORD=admin123
PAGE_AUTH_SECRET=next-log-session-secret-2026

# Vercel Blob Store (用于消息公告大于 64KB 图片的高性能存储)
# 在 Vercel 控制台绑定 Blob Storage 时会自动注入该环境变量
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

